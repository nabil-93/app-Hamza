{
  "expo": {
    "name": "GlucoAI",
    "slug": "glucoai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glucoai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "GlucoAI needs camera access to scan food items for nutrition analysis.",
        "NSMicrophoneUsageDescription": "GlucoAI needs microphone access for voice input in AI chat.",
        "NSPhotoLibraryUsageDescription": "GlucoAI needs photo library access to analyze food images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.glucoai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GlucoAI to access your camera to scan food."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GlucoAI to access your photos."
        }
      ]
    ],
    "scheme": "glucoai",
    "experiments": {
      "typedRoutes": true
    }
  }
}
